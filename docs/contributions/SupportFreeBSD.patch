+def _default_device_index(sd, kind):
+    default = getattr(getattr(sd, 'default', None), 'device', None)
+    slot = 0 if kind == 'input' else 1
+    if isinstance(default, (tuple, list)) and len(default) > slot:
+        index = default[slot]
+        if isinstance(index, int) and index >= 0:
