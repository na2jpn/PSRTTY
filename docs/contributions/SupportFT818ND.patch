diff --git a/psrtty/ui/guide.py b/psrtty/ui/guide.py
index 7213e75..bfac00c 100644
--- a/psrtty/ui/guide.py
+++ b/psrtty/ui/guide.py
@@ -62,7 +62,7 @@ PAGES=[
 ('Cabrillo出力','''<h2>ADIFファイル出力</h2><p><b>ファイル → ADIFファイル出力</b>で、開始・終了日時（選択したJST／UTC）と運用自局コールサインを指定します。該当するバンドを1つ以上選び、交信一覧で出力する行を1件以上チェックします。件数と条件を確認して別のADIFファイルへ保存します。元のログは変更しません。</p>
 <h2>Cabrilloファイル出力</h2><p><b>ファイル → Cabrilloファイル出力</b>で汎用・JARL World Wide RTTY・CQ WW RTTY DXを選択します。CQ WWでは運用地（日本／米国・カナダ／その他）、開催年と期間（UTC）、提出する自局CALLを指定します。対象期間の交信がなければ先へ進めません。交信を1件以上選び、必要なら出力用の値を修正します。異なる自局CALLが混じる場合は赤字で警告しますが、そのまま進められます。</p><p>続いて必須項目、任意項目を入力し、内容と件数を確認して保存します。CQ WWの文字は半角英数字・記号で入力し、氏名・住所はローマ字にしてください。自局CQゾーンは選択した交信のSENTから読み取って表示するので確認します。米国・カナダ以外の運用地はLOCATIONにDX、米国・カナダは州・地域略号を指定します。申告得点は任意で、自動計算しません。CQ WWの空欄の任意ヘッダーも項目名を残します。</p><p>保存したCabrilloファイルは画面に表示するCQ WW RTTY公式提出フォームから送信してください。PSRTTYから自動送信しません。日時はUTC、RTTYはRY、文字はASCII、改行はCRLFで出力します。元ADIFには書き戻しません。JARLでは参加部門、最大出力、運用地を選択して暫定得点を計算します。同一局との交信はバンドごとに1回、同じ大陸は2点、異なる大陸は3点です。判定できない局とJD1などは運用地を手動指定して再計算します。得点とマルチを確認し、必要なら登録クラブ番号を選択し、提出に伴う宣誓を確認します。</p><p>汎用形式は大会識別名とQSO項目の並びを指定できます。提出先の条件を確認してください。編集した出力用データとチェックは元ログを変更しません。</p>'''),
 ('機種別補足','''<h2>ICOM</h2><p>Ver0.77追加：IC-7200 / IC-7410 / IC-7600 / IC-9100（資料確認済み・実機未確認）。USB音声入出力は別途選択してください。DATA時の変調入力を無線機側でUSBに設定します。IC-7600はD1を使用するため、DATA1の変調入力をUSBに設定します。IC-9100は運用するMAIN側を本体で選択してください。これら４機種のフィルター切替は無線機本体で行います。</p><p>無線機本体のCI-Vアドレスと一致させます。IC-7300MK2をIC-7300のアドレスで運用している場合なども、手入力した設定をそのまま使用できます。</p>
-<h2>Yaesu・Kenwood（Hamlib接続）</h2><p>Yaesu FT-991/A、FTX-1、FT-710、FTDX10、FTDX101D・FTDX101MP、FTDX3000、Kenwood TS-590SG、TS-890S、TS-990Sを選択できます。Hamlibの版とライセンスは「PSRTTYについて」に表示します。CATのCOMポートと速度を指定して接続テストを行ってください。YaesuはEnhanced COM、DATA入力はUSB、CAT RTSはDISABLE（OFF）を確認します。FTX-1はCAT対応ファームウェアが必要です。</p>
+<h2>Yaesu・Kenwood（Hamlib接続）</h2><p>Yaesu FT-817（FT-817ND）、FT-818ND、FT-991/A、FTX-1、FT-710、FTDX10、FTDX101D・FTDX101MP、FTDX3000、Kenwood TS-590SG、TS-890S、TS-990Sを選択できます。Hamlibの版とライセンスは「PSRTTYについて」に表示します。CATのCOMポートと速度を指定して接続テストを行ってください。YaesuはEnhanced COM、DATA入力はUSB、CAT RTSはDISABLE（OFF）を確認します。FTX-1はCAT対応ファームウェアが必要です。</p>
 <h3>モード切替</h3><p>コントロール画面のアンテナTUNEの上から、無線機のモードを切り替えます。ICOMはLSB-D／USB-D／LSB／USB、Yaesuは機種のDATA表示、KenwoodはLSB-DATA／USB-DATA／LSB／USBを表示します。TS-990SはD1～D3も選べます。送信中は変更できません。接続時のDATAモード自動切替は接続時だけ働き、ここでの一時的なモード変更は保存しません。</p><h3>接続テスト</h3><p>成功後のテスト接続は約10秒で終了します。継続運用は［接続］を押してください。テスト音の送信中は送信が終わってからテスト接続を終了します。</p><h3>接続ボタン</h3><p>画面左上の［未接続］で接続、青い［接続］で切断します。接続中は連打できません。機種とCOMポートはボタンにマウスを重ねると確認できます。</p><h3>接続の応答確認</h3><p>時間経過だけでは切断しません。周波数の応答取得に3回連続で失敗したときに切断します。途中で応答が戻れば接続を維持します。切断理由と日時はステータス表示・接続表示のツールチップ・運用記録に残します。音声入力は継続します。</p><h3>起動とバージョンアップ</h3><p>起動時にログフォルダーへ一時ファイルを作成・書き込み・削除して確認します。作成や書き込みができない場合は対象パスと理由を表示し、メイン画面を開かず終了します。</p><p>同じフォルダーのPSRTTYは二重起動できません。起動済みならその画面を呼び戻します。</p><p><b>ヘルプ → PSRTTYのバージョンアップ</b>で配布ZIPを選択します。設定・ログをバックアップして更新し、再起動します。開発用のPATCH.zipは指定できません。版が大きく離れて画面内更新できない場合は、PSRTTYを閉じ、新版のバイナリー配布ZIPの中身を既存フォルダーへ上書きしてください。</p>''')]
 
 PAGES.append(("時刻・プリンター", '<h2>時刻表記（JST／UTC）</h2><p>表示 → 時刻表記でJST／UTCを切り替えます。初期値はJST、選択は保存されます。PCのタイムゾーンに依存せず、PCの時計から変換します。現在のQSO・受信送信カード・最新QSO・QSOログの表示を切り替えます。手動日時も同じ交信時点を保って変換し、入力が不正なら切替を止めます。ADIFはUTC、生ログTXTとHAMLOG CSVの保存形式はJSTを維持します。出力画面にUTCなどを明示した項目はその表記に従います。</p>\n<h2>RTTYプリンター</h2><p>ファイル → RTTYプリンターに設定、テスト印刷、印刷対象、出力ON/OFF、印刷待ちを消去があります。起動時は必ずOFFです。対象の初期値は受信のみ（RX）。メインだけを対象とし、サブデコは印刷しません。RXは受信カードが確定した時、TXは正常送信完了時に印刷待ちへ追加します。中断したTX全文は印刷しません。</p><p>「指定文字数以下は印刷しない」は初期ON・1文字。本文の前後の空白・改行を除いて判定し、画面とログは変更しません。時刻の印刷は初期ONで、受付時のJST／UTCを記録します。待ち行列に入った後の時刻表記は変更しません。</p><p>USBシリアルのCOMと速度を指定してください（初期115200 bps、8N1）。ASCII、改行LF、初期32文字幅、0.5秒間隔で送ります。無線機・外部制御と同じCOMは使用できません。無線機のCOM自動探索も避け、明示指定してください。対応ファームではACK待ちを有効にでき、各行のOK＋改行を待ちます。通常モードは実印字完了を確認できないため、実機に合う送出間隔で確認してください。</p><p>待ち上限は初期500件。上限や通信エラーでは受付を止め、未送出の待ちを保持してステータス欄へ表示します。受信・送信・ログ保存は続き、ダイアログや音で割り込みません。再開は出力をON。送出途中のエラーは結果不明として自動再送しません。OFF・待ち消去・終了では未送出分を取り消します。送出済みの印刷は取り消せない場合があります。</p>'))
